# Set these environment variables in RunPod's template, using its Secret selector.
# CIVITAI_TOKEN={{ RUNPOD_SECRET_CIVITAI_TOKEN }}
# HF_TOKEN={{ RUNPOD_SECRET_HF_TOKEN }}
# Do not paste actual tokens into this repository.
ILLUSTRIOUS_WORKSPACE=/workspace
ILLUSTRIOUS_PORT=8188
# ILLUSTRIOUS_COMFY_DIR=/workspace/illustrious-runtime/ComfyUI
# ILLUSTRIOUS_PYTHON=/opt/venvs/core/bin/python
# ILLUSTRIOUS_LISTEN=0.0.0.0
# ILLUSTRIOUS_SKIP_DOWNLOAD=1
# Optional JSON manifest with HTTPS URLs + SHA-256 for additional LoRAs:
# ILLUSTRIOUS_LORA_MANIFEST=/workspace/my-loras.json
